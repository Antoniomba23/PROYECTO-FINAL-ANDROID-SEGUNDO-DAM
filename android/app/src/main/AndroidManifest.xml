<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Nivel 6: Permiso de Internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudyBro"
        tools:targetApi="31">

        <!-- Activity Principal (Login al inicio) -->
        <activity
            android:name=".activities.ActividadPrincipal"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".activities.ActividadRegistro" />
        <activity android:name=".activities.ActividadLogin" />
        <activity android:name=".activities.ActividadDetalle" />
        <activity android:name=".activities.ActividadPerfil" />
        <activity android:name=".activities.ActividadNuevaPublicacion" />
        <activity android:name=".activities.ActividadPublicaciones" />
        <activity android:name=".activities.ActividadPerfilCentro" />

    </application>

</manifest>
