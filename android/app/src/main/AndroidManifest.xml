<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Nivel 6: Permiso de Internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.StudyBro"
        tools:targetApi="31">

        <!-- Pantalla de inicio (Splash) -->
        <activity
            android:name=".activities.ActividadSplash"
            android:exported="true"
            android:theme="@style/Theme.StudyBro.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activity Principal -->
        <activity
            android:name=".activities.ActividadPrincipal"
            android:exported="true"
            android:theme="@style/Theme.StudyBro.NoActionBar">
        </activity>

        <activity android:name=".activities.ActividadRegistro"
            android:theme="@style/Theme.StudyBro.NoActionBar"/>
        <activity android:name=".activities.ActividadLogin"
            android:theme="@style/Theme.StudyBro.NoActionBar"/>
        <activity android:name=".activities.ActividadDetalle"
            android:theme="@style/Theme.StudyBro.NoActionBar"/>
        <activity android:name=".activities.ActividadPerfil"
            android:theme="@style/Theme.StudyBro.NoActionBar"/>
        <activity android:name=".activities.ActividadNuevaPublicacion"
            android:theme="@style/Theme.StudyBro.NoActionBar"/>
        <activity android:name=".activities.ActividadPublicaciones"
            android:theme="@style/Theme.StudyBro.NoActionBar"/>
        <activity android:name=".activities.ActividadPerfilCentro"
            android:theme="@style/Theme.StudyBro.NoActionBar"/>
        <activity android:name=".activities.ActividadAsignaturas"
            android:theme="@style/Theme.StudyBro.NoActionBar"/>
        <activity android:name=".activities.ActividadSeleccionarCentro"
            android:theme="@style/Theme.StudyBro.NoActionBar"/>

    </application>

</manifest>
