<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:titleTextColor="@android:color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Nombre -->
            <TextView
                android:id="@+id/tvDetalleNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <!-- Categoría -->
            <TextView
                android:id="@+id/tvDetalleCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/primary"
                android:layout_marginBottom="4dp" />

            <!-- Autor -->
            <TextView
                android:id="@+id/tvDetalleAutor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="16dp" />

            <!-- Descripción -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp">
                <TextView
                    android:id="@+id/tvDetalleDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Votos -->
            <TextView
                android:id="@+id/tvDetalleVotos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <!-- Botones Like / Dislike -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnLike"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="👍 Me gusta"
                    android:backgroundTint="@color/like_color"
                    style="@style/Widget.MaterialComponents.Button" />

                <Button
                    android:id="@+id/btnDislike"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="👎 No me gusta"
                    android:backgroundTint="@color/dislike_color"
                    style="@style/Widget.MaterialComponents.Button" />

            </LinearLayout>

            <!-- Botón Abrir -->
            <Button
                android:id="@+id/btnAbrirArchivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="📂 Abrir / Descargar"
                android:backgroundTint="@color/primary"
                style="@style/Widget.MaterialComponents.Button" />

            <!-- Botón Favorito -->
            <Button
                android:id="@+id/btnFavorito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="☆ Añadir a favoritos"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <!-- ProgressBar descarga -->
            <ProgressBar
                android:id="@+id/pbDescargando"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginBottom="8dp"
                android:indeterminate="true"
                android:progressTint="@color/accent"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Al añadir a favoritos el archivo se descarga en tu dispositivo para verlo sin internet."
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp"
                android:gravity="center" />

            <!-- Botón Reportar -->
            <Button
                android:id="@+id/btnReportar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚩 Reportar archivo"
                android:backgroundTint="@color/dislike_color"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

            <!-- SECCIÓN DE COMENTARIOS -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Comentarios"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvComentarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="12dp" />

            <!-- Input para comentar (Solo usuarios registrados) -->
            <LinearLayout
                android:id="@+id/llComentarInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etNuevoComentario"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Escribe un comentario..."
                    android:background="@drawable/bg_mensaje_user"
                    android:padding="12dp"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnEnviarComentario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_send"
                    app:backgroundTint="@color/primary"
                    app:tint="@android:color/white"
                    app:fabSize="mini" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvAvisoLoginComentario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Debes iniciar sesión para comentar."
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:padding="12dp"
                android:background="@drawable/bg_mensaje_ai"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
