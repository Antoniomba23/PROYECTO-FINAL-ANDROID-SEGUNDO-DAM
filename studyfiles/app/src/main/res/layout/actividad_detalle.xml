<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:titleTextColor="@android:color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Nombre -->
            <TextView
                android:id="@+id/tvDetalleNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <!-- Categoría -->
            <TextView
                android:id="@+id/tvDetalleCategoria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/primary"
                android:layout_marginBottom="4dp" />

            <!-- Autor -->
            <TextView
                android:id="@+id/tvDetalleAutor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="16dp" />

            <!-- Descripción -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="12dp">
                <TextView
                    android:id="@+id/tvDetalleDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Votos -->
            <TextView
                android:id="@+id/tvDetalleVotos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:gravity="center"
                android:layout_marginBottom="12dp" />

            <!-- Botones Like / Dislike -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/btnLike"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="👍 Me gusta"
                    android:backgroundTint="@color/like_color"
                    style="@style/Widget.MaterialComponents.Button" />

                <Button
                    android:id="@+id/btnDislike"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="👎 No me gusta"
                    android:backgroundTint="@color/dislike_color"
                    style="@style/Widget.MaterialComponents.Button" />

            </LinearLayout>

            <!-- Botón Abrir -->
            <Button
                android:id="@+id/btnAbrirArchivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="📂 Abrir / Descargar"
                android:backgroundTint="@color/primary"
                style="@style/Widget.MaterialComponents.Button" />

            <!-- Botón Favorito -->
            <Button
                android:id="@+id/btnFavorito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="☆ Añadir a favoritos"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <!-- Botón Reportar -->
            <Button
                android:id="@+id/btnReportar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚩 Reportar archivo"
                android:backgroundTint="@color/dislike_color"
                style="@style/Widget.MaterialComponents.Button.TextButton" />

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
